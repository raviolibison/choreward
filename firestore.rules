rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isHouseholdMember(householdId) {
      let h = get(/databases/$(database)/documents/households/$(householdId)).data;
      return request.auth.uid in h.parentIds ||
             request.auth.uid in h.get('childIds', []);
    }

    function isHouseholdParent(householdId) {
      return request.auth.uid in
             get(/databases/$(database)/documents/households/$(householdId)).data.parentIds;
    }

    // Users can manage their own document, but may never increase their own
    // points — only decrease (reward redemption transaction).
    // A parent in one of the target user's households may adjust that
    // user's `points` field only (chore-approval awards).
    match /users/{userId} {
      allow read: if isAuth();
      allow create, delete: if isAuth() && request.auth.uid == userId;

      allow update: if isAuth() && request.auth.uid == userId && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['points']) ||
        request.resource.data.points < resource.data.points
      );

      allow update: if isAuth() && request.auth.uid != userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points']) &&
        resource.data.get('householdIds', []).size() > 0 &&
        request.auth.uid in
          get(/databases/$(database)/documents/households/$(resource.data.householdIds[0])).data.parentIds;
    }

    match /households/{householdId} {
      // Broad read needed so invite-code lookups work before membership is established.
      allow read: if isAuth();
      allow create: if isAuth();
      allow delete: if isAuth() && isHouseholdParent(householdId);
      // Note: joining a household (adding your own UID to parentIds/childIds)
      // is NOT allowed here — it requires proving possession of an invite
      // code, which can only be verified server-side. See the
      // `joinHousehold` callable Cloud Function, which uses the Admin SDK
      // and bypasses these rules.
      allow update: if isAuth() && (
        // Existing parents can change anything.
        isHouseholdParent(householdId) ||
        // Self-service leave: remove only own UID from parentIds or childIds.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parentIds']) &&
         resource.data.parentIds.hasAll(request.resource.data.parentIds) &&
         resource.data.parentIds.removeAll(request.resource.data.parentIds).hasOnly([request.auth.uid])) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['childIds']) &&
         resource.data.get('childIds', []).hasAll(request.resource.data.get('childIds', [])) &&
         resource.data.get('childIds', []).removeAll(request.resource.data.get('childIds', [])).hasOnly([request.auth.uid]))
      );

      match /chores/{choreId} {
        allow read: if isAuth() && isHouseholdMember(householdId);
        allow create, delete: if isAuth() && isHouseholdParent(householdId);
        allow update: if isAuth() && isHouseholdMember(householdId) && (
          isHouseholdParent(householdId) ||
          // Children may only write the proof-submission fields.
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'proofUrl', 'submittedBy', 'submittedByName', 'submittedAt'])
        );
      }

      match /rewards/{rewardId} {
        allow read: if isAuth() && isHouseholdMember(householdId);
        allow write: if isAuth() && isHouseholdParent(householdId);
      }

      match /redemptions/{redemptionId} {
        allow read: if isAuth() && isHouseholdMember(householdId);
        allow create: if isAuth() && isHouseholdMember(householdId);
        allow update: if isAuth() && isHouseholdParent(householdId);
        allow delete: if false;
      }
    }
  }
}
